
import numpy as np
from scipy import stats

alpha = 0.005
beta = 0.01
gamma = 0.10

P = np.array([
    [1 - beta, beta,      0],
    [0,        1 - gamma, gamma],
    [alpha,    0,         1 - alpha]
])


rng = np.random.default_rng(42)
estimat = np.zeros((30, 3))

for k in range(30):
    tilstand = 0  # Start som mottakeleg
    dagar = np.zeros(3)

    for dag in range(1, 7301):
        # Trekk eit tal i [0, 1) og bruk sannsyna i rada til dagens tilstand.
        u = rng.random()
        if u < P[tilstand, 0]:
            tilstand = 0
        elif u < P[tilstand, 0] + P[tilstand, 1]:
            tilstand = 1
        else:
            tilstand = 2

        # Tel berre dei siste 10 åra: dag 3651-7300.
        if dag > 3650:
            dagar[tilstand] += 1

    # Gjennomsnittleg tal dagar per år i kvar tilstand.
    estimat[k] = dagar / 10


snitt = estimat.mean(axis=0)

nedre, øvre = stats.t.interval(
    confidence=0.95,
    df=len(estimat) - 1,
    loc=snitt,
    scale=stats.sem(estimat, axis=0)
)

for j, namn in enumerate(["S", "I", "R"]):
    print(f"{namn}: 95 % KI = [{nedre[j]:.2f}, {øvre[j]:.2f}] dagar/år")
