      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function euler_rates = gyro_vec_to_euler_rates(euler_angles, gyro_vec)
%#codegen
    phi = euler_angles(1);
    theta = euler_angles(2);

    T = [1, sin(phi)*tan(theta), cos(phi)*tan(theta);
         0, cos(phi),            -sin(phi);
         0, sin(phi)/cos(theta), cos(phi)/cos(theta)]; 
euler_rates = T*gyro_vec;
% euler_rates(3) = -euler_rates(3);</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
      </eml>
    </state>
